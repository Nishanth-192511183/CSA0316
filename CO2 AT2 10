#include <stdio.h>

#define SIZE 5

int queue[SIZE];
int front = -1;
int rear = -1;

void enqueue(int item)
{
    if((rear + 1) % SIZE == front)
    {
        printf("Queue Full\n");
        return;
    }

    if(front == -1)
    {
        front = 0;
    }

    rear = (rear + 1) % SIZE;
    queue[rear] = item;

    printf("%d inserted into queue\n", item);
}

void display()
{
    int i;

    if(front == -1)
    {
        printf("Queue is empty");
        return;
    }

    printf("Queue elements: ");

    i = front;

    while(1)
    {
        printf("%d ", queue[i]);

        if(i == rear)
        {
            break;
        }

        i = (i + 1) % SIZE;
    }
}

int main()
{
    enqueue(10);
    enqueue(20);
    enqueue(30);
    enqueue(40);
    enqueue(50);

    display();

    return 0;
}
